{
  "name": "daymark-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host localhost",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host localhost",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && node scripts/cloudflare.mjs deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/cloudflare.mjs d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/luxon3": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.11.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrule": "^2.8.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "sql.js": "^1.14.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.114.0"
  }
}
